# Wetigo — environment configuration
# Copy to ".env" and fill in. All client vars must be prefixed with VITE_.

# Base URL of your backend API (no trailing slash). Defaults to "/api" if unset.
VITE_API_URL=https://api.wetigo.com

# Stripe publishable key (pk_live_… or pk_test_…). Enables real Checkout.
VITE_STRIPE_PUBLISHABLE_KEY=
